{
    "name": "fapfap69/pesm",
    "description": "PHP Embedded Scripts Manager - A high-performance scripting engine with bytecode compilation and DSL toolkit",
    "type": "library",
    "keywords": ["scripting", "dsl", "bytecode", "vm", "parser", "workflow", "embedded"],
    "license": "MIT",
    "homepage": "https://github.com/fapfap69/PESM",
    "authors": [
        {
            "name": "Antonio Franco",
            "email": "antonio.franco@ba.infn.it",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/fapfap69/PESM/issues",
        "source": "https://github.com/fapfap69/PESM"
    },
    "require": {
        "php": ">=8.0",
        "hafriedlander/php-peg": "^0.7"
    },
    "autoload": {
        "psr-4": {
            "PESM\\": "src/"
        }
    },
    "bin": [
        "bin/build-parser.php"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
