{
    "name": "infn/pesm",
    "description": "PHP Embedded Scripts Manager - Standalone script engine for custom scripting language",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Antonio Franco",
            "email": "antonio.franco@ba.infn.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "smuuf/php-peg": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "PESM\\": "src/"
        }
    },
    "bin": [
        "bin/build-parser.php"
    ],
    "keywords": [
        "script-engine",
        "parser",
        "runtime",
        "embedded-language",
        "workflow"
    ]
}
