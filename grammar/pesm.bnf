# PESM Language Grammar (BNF)
# PHP Embedded Scripts Manager - Formal Language Definition

## Program Structure
<program>          ::= <statement>*

<statement>        ::= <assignment>
                     | <function_def>
                     | <if_block>
                     | <foreach_block>
                     | <while_block>
                     | <for_block>
                     | <return_stmt>
                     | <command>
                     | <expression_stmt>

## Function Definition
<function_def>     ::= "FUNCTION" <identifier> "(" <param_list>? ")" <statement>* "END"
<param_list>       ::= <identifier> ("," <identifier>)*
<return_stmt>      ::= "RETURN" <expression>?

## Control Flow
<if_block>         ::= "IF" <condition> <statement>* ("ELSE" "IF" <condition> <statement>*)* ("ELSE" <statement>*)? "END"
<foreach_block>    ::= "FOREACH" <identifier> "IN" <expression> <statement>* "END"
                     | "FOREACH" <identifier> "=" <expression> "TO" <expression> <statement>* "END"
<while_block>      ::= "WHILE" <condition> <statement>* "END"
<for_block>        ::= "FOR" <identifier> "=" <expression> "TO" <expression> ("STEP" <expression>)? <statement>* "END"

## Assignment
<assignment>       ::= <identifier> "=" <expression>
                     | <identifier> "[" <expression> "]" "=" <expression>

## Expressions
<expression>       ::= <logical_or>

<logical_or>       ::= <logical_and> ("OR" <logical_and>)*
<logical_and>      ::= <equality> ("AND" <equality>)*
<equality>         ::= <comparison> (("==" | "!=") <comparison>)*
<comparison>       ::= <additive> ((">" | ">=" | "<" | "<=") <additive>)*
<additive>         ::= <multiplicative> (("+" | "-") <multiplicative>)*
<multiplicative>   ::= <unary> (("*" | "/" | "%") <unary>)*
<unary>            ::= ("!" | "-") <unary> | <postfix>
<postfix>          ::= <primary> ("[" <expression> "]")*

<primary>          ::= <literal>
                     | <identifier>
                     | <function_call>
                     | "(" <expression> ")"

## Function Call
<function_call>    ::= <identifier> "(" <arg_list>? ")"
<arg_list>         ::= <expression> ("," <expression>)*

## Commands
<command>          ::= "MESSAGE" <expression>
                     | "ACCEPT" <string>?
                     | "REFUSE" <string>?
                     | "INPUT_MASK" <string>
                     | "SUBMIT_FORM" <string>

## Literals
<literal>          ::= <number>
                     | <string>
                     | <boolean>
                     | <array>
                     | <dictionary>

<number>           ::= [0-9]+ ("." [0-9]+)?
<string>           ::= '"' [^"]* '"' | "'" [^']* "'"
<boolean>          ::= "true" | "false" | "TRUE" | "FALSE"
<array>            ::= "[" (<expression> ("," <expression>)*)? "]"
<dictionary>       ::= "{" (<string> ":" <expression> ("," <string> ":" <expression>)*)? "}"

## Identifiers
<identifier>       ::= [a-zA-Z_][a-zA-Z0-9_]*

## Conditions
<condition>        ::= <expression>

## Expression Statement
<expression_stmt>  ::= <expression>

## Comments
<comment>          ::= "//" [^\n]* "\n"
                     | "/*" .* "*/"

## Whitespace (ignored)
<whitespace>       ::= [ \t\n\r]+
