// ═══════════════════════════════════════════════════════════
// PESM Comprehensive Language Test
// Tests all constructs, nesting, and interrupt handling
// ═══════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────
// 1. STRUCT Definitions
// ───────────────────────────────────────────────────────────
STRUCT Point x y
END

STRUCT Person name age city
END

STRUCT Employee name salary department
END

// ───────────────────────────────────────────────────────────
// 2. Function Definitions
// ───────────────────────────────────────────────────────────
FUNCTION add(a, b)
    result = a + b
    RETURN result
END

FUNCTION factorial(n)
    IF n <= 1
        RETURN 1
    END
    RETURN n * factorial(n - 1)
END

FUNCTION processArray(arr)
    sum = 0
    FOREACH item IN arr
        sum = sum + item
    END
    RETURN sum
END

// ───────────────────────────────────────────────────────────
// 3. Variables and Literals
// ───────────────────────────────────────────────────────────
counter = 0
name = "PESM Test"
version = 3.0
enabled = 1

// Arrays
numbers = [10, 20, 30, 40, 50]
matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]

// Objects
config = {"debug": 1, "timeout": 30, "retries": 3}

// ───────────────────────────────────────────────────────────
// 4. STRUCT Instantiation
// ───────────────────────────────────────────────────────────
p1 = MAKE Point(10, 20)
person = MAKE Person(name: "Mario", age: 30, city: "Rome")
emp = MAKE Employee("Luigi", 50000, "IT")

// ───────────────────────────────────────────────────────────
// 5. Expressions and Operators
// ───────────────────────────────────────────────────────────
// Arithmetic
x = 10 + 5 * 2
y = (x - 5) / 3
z = y % 2

// Comparison
isGreater = x > y
isEqual = x == 20
isDifferent = x != y

// Logical
condition1 = x > 10 AND y < 20
condition2 = enabled OR NOT isEqual
condition3 = (x >= 15) AND (y <= 10) OR (z == 0)

// Unary
negative = -x
positive = +y
inverted = NOT enabled

// ───────────────────────────────────────────────────────────
// 6. Array and Property Access
// ───────────────────────────────────────────────────────────
first = numbers[0]
matrixValue = matrix[1][2]
numbers[2] = 99
matrix[0][1] = 88

personName = person.name
personAge = person.age
pointX = p1.x

// ───────────────────────────────────────────────────────────
// 7. IF-ELSE Statement
// ───────────────────────────────────────────────────────────
IF x > 15
    status = "high"
    MESSAGE "Value is high: " + x
ELSE
    status = "low"
    MESSAGE "Value is low: " + x
END

// Nested IF
IF status == "high"
    IF x > 25
        level = 3
    ELSE
        level = 2
    END
ELSE
    level = 1
END

// ───────────────────────────────────────────────────────────
// 8. SWITCH-CASE Statement
// ───────────────────────────────────────────────────────────
SWITCH level
    CASE 1
        MESSAGE "Level 1: Basic"
    CASE 2
        MESSAGE "Level 2: Intermediate"
    CASE 3
        MESSAGE "Level 3: Advanced"
    DEFAULT
        MESSAGE "Unknown level"
END

// ───────────────────────────────────────────────────────────
// 9. WHILE Loop
// ───────────────────────────────────────────────────────────
counter = 0
WHILE counter < 5
    counter = counter + 1
    MESSAGE "WHILE counter: " + counter
    
    IF counter == 3
        CONTINUE
    END
    
    sum = sum + counter
END

// ───────────────────────────────────────────────────────────
// 10. DO-WHILE Loop
// ───────────────────────────────────────────────────────────
attempts = 0
DO
    attempts = attempts + 1
    MESSAGE "DO-WHILE attempt: " + attempts
WHILE attempts < 3

// ───────────────────────────────────────────────────────────
// 11. REPEAT-UNTIL Loop
// ───────────────────────────────────────────────────────────
value = 0
REPEAT
    value = value + 10
    MESSAGE "REPEAT value: " + value
UNTIL value >= 30

// ───────────────────────────────────────────────────────────
// 12. FOREACH with Range
// ───────────────────────────────────────────────────────────
rangeSum = 0
FOREACH i = 1 TO 10
    rangeSum = rangeSum + i
    
    IF i == 5
        MESSAGE "Halfway through range"
    END
END

// ───────────────────────────────────────────────────────────
// 13. FOREACH with Array
// ───────────────────────────────────────────────────────────
arraySum = 0
FOREACH num IN numbers
    arraySum = arraySum + num
    MESSAGE "Processing: " + num
END

// ───────────────────────────────────────────────────────────
// 14. BREAK and CONTINUE
// ───────────────────────────────────────────────────────────
FOREACH i = 1 TO 20
    IF i % 2 == 0
        CONTINUE
    END
    
    IF i > 15
        BREAK
    END
    
    oddSum = oddSum + i
END

// ───────────────────────────────────────────────────────────
// 15. Nested Loops
// ───────────────────────────────────────────────────────────
FOREACH row = 0 TO 2
    FOREACH col = 0 TO 2
        cell = matrix[row][col]
        MESSAGE "Cell[" + row + "][" + col + "] = " + cell
    END
END

// ───────────────────────────────────────────────────────────
// 16. Function Calls
// ───────────────────────────────────────────────────────────
sumResult = add(10, 20)
fact5 = factorial(5)
arrayTotal = processArray(numbers)

MESSAGE "Sum: " + sumResult
MESSAGE "Factorial(5): " + fact5
MESSAGE "Array total: " + arrayTotal

// ───────────────────────────────────────────────────────────
// 17. GOTO and Labels
// ───────────────────────────────────────────────────────────
gotoTest = 1
GOTO skipSection
gotoTest = 999
skipSection:
gotoTest = gotoTest + 10
MESSAGE "GOTO test value: " + gotoTest

// ───────────────────────────────────────────────────────────
// 18. Interrupt Commands
// ───────────────────────────────────────────────────────────
MESSAGE "Starting interrupt sequence"

INPUT "Enter your name: " userName
MESSAGE "Hello " + userName

IF userName == "admin"
    ACCEPT "approved"
ELSE
    REFUSE "denied"
END

// ───────────────────────────────────────────────────────────
// 19. Complex Nested Structure
// ───────────────────────────────────────────────────────────
FOREACH outer = 1 TO 3
    MESSAGE "Outer loop: " + outer
    
    SWITCH outer
        CASE 1
            WHILE counter < 10
                counter = counter + 1
                IF counter == 8
                    BREAK
                END
            END
        CASE 2
            DO
                temp = temp + 1
            WHILE temp < 5
        CASE 3
            REPEAT
                final = final + 1
            UNTIL final >= 3
    END
    
    IF outer == 2
        MESSAGE "Middle iteration"
    END
END

// ───────────────────────────────────────────────────────────
// 20. Final Summary
// ───────────────────────────────────────────────────────────
MESSAGE "═══════════════════════════════════════"
MESSAGE "PESM Comprehensive Test Complete"
MESSAGE "═══════════════════════════════════════"
MESSAGE "Variables: " + counter
MESSAGE "Functions: " + sumResult
MESSAGE "Structs: " + person.name
MESSAGE "Arrays: " + numbers[0]
MESSAGE "Loops: " + rangeSum
MESSAGE "Status: SUCCESS"
